# ---------------------------------------------------------------------------
# Public — safe in the browser. The anon key can only do what RLS allows
# (read active categories / published portfolio, upload to a signed URL).
# ---------------------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server only — NEVER prefix with NUXT_PUBLIC_, never commit real values.
# ---------------------------------------------------------------------------
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string. Generate one with: openssl rand -hex 32
NUXT_RATE_LIMIT_SALT=

# Optional: email alert to you on each new request/message (Resend).
# Leave empty to disable. NOTIFY_FROM must be on a domain verified in Resend.
NUXT_RESEND_API_KEY=
NUXT_NOTIFY_EMAIL=
NUXT_NOTIFY_FROM=
